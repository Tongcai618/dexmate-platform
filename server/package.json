{
  "name": "dexmate-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=23.6" },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "totp": "node src/scripts/totp.ts",
    "reset": "rm -f dexmate.db dexmate.db-wal dexmate.db-shm"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
